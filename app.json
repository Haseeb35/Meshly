{
  "expo": {
    "name": "BLACKBOX",
    "slug": "blackbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020802",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.haseeb35.meshly",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "BLACKBOX uses Bluetooth to find nearby phones and exchange messages without the internet."
      }
    },
    "android": {
      "package": "io.github.haseeb35.meshly",
      "adaptiveIcon": {
        "backgroundColor": "#020802",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "BLACKBOX uses Bluetooth to find nearby phones and exchange messages without the internet."
        }
      ],
      "expo-build-properties",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BLACKBOX uses Face ID to lock your messages."
        }
      ]
    ]
  }
}
